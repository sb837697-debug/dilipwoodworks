# ==========================================
# Dilip Wood Works - Environment Configuration
# ==========================================

# Form Endpoint: Connect any service such as Formspree, Web3Forms, or custom REST endpoint
# Example: https://formspree.io/f/xvonzxyz
# Example: https://api.web3forms.com/submit
VITE_CONTACT_FORM_ENDPOINT=

# Site URL for canonical meta tags & sitemap links
VITE_SITE_URL=https://dilipwoodworks.com

# Optional Analytics Tracking ID (Google Analytics 4 / Plausible)
VITE_GA_TRACKING_ID=

# ==========================================
# Meta (Facebook) Conversions API & Pixel
# ==========================================
# Meta Pixel ID (Site's active pixel: 2540746766357872)
META_PIXEL_ID=2540746766357872
VITE_META_PIXEL_ID=2540746766357872

# Meta Conversions API Access Token
# Obtain from: Meta Events Manager -> Select Pixel/Dataset -> Settings -> Conversions API -> "Generate access token"
META_CONVERSION_API_TOKEN=

# Optional: Meta Test Event Code (e.g., TEST12345 from Events Manager -> "Test events" tab)
META_TEST_EVENT_CODE=
